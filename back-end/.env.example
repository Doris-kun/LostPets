# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Cloudinary (https://console.cloudinary.com -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# MongoDB connection string (Atlas or local)
# Local example: mongodb://localhost:27017/lost-pets
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lost-pets?retryWrites=true&w=majority

# Claude API key for the AI photo analysis endpoint
# Get one at https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
