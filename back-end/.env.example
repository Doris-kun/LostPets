# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Cloudinary (https://console.cloudinary.com -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# MongoDB connection string (Atlas or local)
# Local example: mongodb://localhost:27017/lost-pets
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lost-pets?retryWrites=true&w=majority

# Google Gemini API key for the AI photo analysis endpoint
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Domain được phép gọi API, ngăn cách bằng dấu phẩy.
# Để trống thì API mở cho mọi domain (có cảnh báo trong log).
# Production: https://lostpets-1.onrender.com
FRONTEND_URL=http://localhost:8080

# Chuỗi bí mật để ký JWT đăng nhập. Tự sinh một chuỗi ngẫu nhiên dài:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Để trống thì phần đăng nhập tắt (trả 503), phần còn lại của web vẫn chạy.
JWT_SECRET=

# Email của quản trị viên, ngăn cách bằng dấu phẩy.
# Tài khoản có email trong danh sách này được cấp quyền admin khi đăng nhập.
ADMIN_EMAILS=

# Mã bí mật để cron gọi POST /admin/cleanup mà không cần đăng nhập.
# Tự sinh giống JWT_SECRET. Phải trùng với secret CLEANUP_TOKEN trên GitHub.
# Để trống thì chỉ quản trị viên bấm tay dọn được, cron bị từ chối.
CLEANUP_TOKEN=

# Giữ tin đã đánh dấu đoàn tụ thêm bao nhiêu ngày rồi xoá hẳn. Mặc định 30.
# Hạ xuống 1 khi cần kiểm tra đợt dọn có chạy thật hay không.
CLEANUP_AFTER_DAYS=

# Số lượt tìm kiếm có chữ cho mỗi IP trong 10 phút. Mặc định 60.
# Mỗi lượt tìm gọi Gemini để nhúng câu hỏi nên phải chặn vòng lặp tự động.
# Duyệt danh sách bình thường (không gõ gì vào ô tìm kiếm) không bị đếm.
SEARCH_RATE_LIMIT=

# Bật tầng tái xếp hạng kết quả tìm kiếm bằng AI: SEARCH_RERANK=on. Mặc định tắt.
# Đã đo trên 20 câu hỏi (npm run eval:matching -- --vector --search):
#   precision@1 65% -> 100%, nhưng precision@3 vốn đã 100% ở cả hai bên,
#   còn thời gian mỗi lượt tìm 437ms -> 5509ms.
# Tức là nó chỉ đẩy đáp án từ hàng 2-3 lên hàng 1, đổi lấy năm giây chờ. Để tắt.
SEARCH_RERANK=

# Số báo cáo tin xấu cho mỗi IP trong một giờ. Mặc định 20.
# Một người thật báo cáo vài tin là cùng; ai gửi hàng trăm lượt thì đang cố
# nhấn chìm hàng chờ của quản trị viên chứ không phải đang tố cáo.
REPORT_RATE_LIMIT=

# Đăng nhập bằng Google. Lấy ở Google Cloud Console > APIs & Services >
# Credentials > Create OAuth client ID > Web application.
# Dạng 123456-abcdef.apps.googleusercontent.com
# Để trống thì nút Google không hiện, phần còn lại của web vẫn chạy.
GOOGLE_CLIENT_ID=

# Client ID riêng cho app mobile. Google bắt buộc mỗi nền tảng một mã, nên ID
# token phát cho app mang `aud` khác bản web — thiếu hai mã này thì người dùng
# đăng nhập Google từ app sẽ bị back-end từ chối.
# Tạo ở cùng project với mã web: Credentials > Create OAuth client ID > iOS
# (điền Bundle ID) và > Android (điền package name + SHA-1 fingerprint).
# Để trống thì chỉ web đăng nhập được, phần còn lại không ảnh hưởng gì.
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Có chìa nút đăng nhập Facebook ra cho mọi người không: FACEBOOK_PUBLIC=on.
# MẶC ĐỊNH TẮT, và đó là lựa chọn có chủ ý.
#
# Ứng dụng Meta đang ở chế độ Development nên chỉ người có vai trò trong ứng
# dụng mới đăng nhập được; người lạ bấm vào nhận màn hình "App not active".
# Một nút chắc chắn hỏng giữa màn hình đăng nhập còn tệ hơn là không có nút,
# nhất là khi chạy UAT với người ngoài.
#
# Tính năng không bị gỡ: POST /auth/facebook vẫn chạy bình thường. Bật lại để
# demo, hoặc khi ứng dụng Meta được duyệt sang chế độ Live.
FACEBOOK_PUBLIC=

# Đăng nhập bằng Facebook. Lấy ở developers.facebook.com > app của bạn >
# Settings > Basic. App secret là chuỗi bấm "Show" mới thấy.
# Để trống một trong hai thì nút Facebook không hiện.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
