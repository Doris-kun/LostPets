{
  "expo": {
    "name": "LostPets",
    "slug": "lostpets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": ["lostpets", "com.lostpets.app", "fb1099308289611667"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lostpets.app",
      "infoPlist": {
        "CFBundleLocalizations": ["vi", "en"],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "lostpets-1.onrender.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "lostpets-1.onrender.com",
              "pathPrefix": "/verify-email"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.lostpets.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1F5C7A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-full.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LostPets xem thư viện ảnh để bạn chọn ảnh con vật cho bài đăng.",
          "cameraPermission": "LostPets dùng camera để bạn chụp ảnh con vật ngay tại chỗ, khỏi phải thoát ra app Camera."
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LostPets dùng vị trí của bạn để đánh dấu nơi mất hoặc nơi nhặt được thú cưng trên bản đồ. Vị trí được làm mờ thành một vùng rộng khoảng 500m trước khi lưu."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "8ab7a83a-6352-4e16-b8a4-8e96c33f2afd"
      }
    }
  }
}
